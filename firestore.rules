rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'uid', 'nama', 'universitas', 'jurusan', 'semester', 'mood', 'photoBase64', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'nama', 'universitas', 'jurusan', 'semester', 'mood', 'photoBase64', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 100
        && data.universitas is string && data.universitas.size() <= 120
        && data.jurusan is string && data.jurusan.size() <= 120
        && data.semester is string && data.semester.size() <= 40
        && data.mood is string && data.mood.size() <= 60
        && data.photoBase64 is string && data.photoBase64.size() <= 150000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll([
          'uid', 'category', 'title', 'date', 'startTime', 'endTime', 'completed',
          'room', 'lecturer', 'sks', 'location', 'notes', 'priority', 'subType',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'category', 'title', 'date', 'startTime', 'endTime', 'completed',
          'room', 'lecturer', 'sks', 'location', 'notes', 'priority', 'subType',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.category in ['matkul', 'harian', 'acara', 'rapat_deadline']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.endTime is string && data.endTime.size() <= 5
        && data.completed is bool
        && data.room is string && data.room.size() <= 80
        && data.lecturer is string && data.lecturer.size() <= 80
        && data.sks is number && data.sks >= 0 && data.sks <= 12
        && data.location is string && data.location.size() <= 150
        && data.notes is string && data.notes.size() <= 300
        && data.priority in ['tinggi', 'sedang', 'rendah', '']
        && data.subType in ['rapat', 'deadline', '']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/profile/{profileId} {
      allow get: if isOwner(userId) && isValidId(profileId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId)
        && profileId == 'main'
        && isValidProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && profileId == 'main'
        && isValidProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nama', 'universitas', 'jurusan', 'semester', 'mood', 'photoBase64', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && profileId == 'main';
    }

    match /users/{userId}/schedules/{scheduleId} {
      allow get: if isOwner(userId) && isValidId(scheduleId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'category', 'title', 'date', 'startTime', 'endTime',
            'room', 'lecturer', 'sks', 'location', 'notes', 'priority', 'subType', 'completed', 'updatedAt'
          ])
        );
      allow delete: if isOwner(userId) && isValidId(scheduleId);
    }
  }
}
