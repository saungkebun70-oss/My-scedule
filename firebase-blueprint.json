{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student academic profile, mood status, and compressed avatar data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "universitas": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "jurusan": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "semester": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "mood": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "photoBase64": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "nama",
        "universitas",
        "jurusan",
        "semester",
        "mood",
        "photoBase64",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Academic or daily schedule entry belonging to a specific user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["matkul", "harian", "acara", "rapat_deadline"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "endTime": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5
        },
        "completed": {
          "type": "boolean"
        },
        "room": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "lecturer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "sks": {
          "type": "number"
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "priority": {
          "type": "string",
          "enum": ["tinggi", "sedang", "rendah", ""]
        },
        "subType": {
          "type": "string",
          "enum": ["rapat", "deadline", ""]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "category",
        "title",
        "date",
        "startTime",
        "endTime",
        "completed",
        "room",
        "lecturer",
        "sks",
        "location",
        "notes",
        "priority",
        "subType",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/profile/{profileId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private academic profile document owned by the authenticated user."
    },
    "/users/{userId}/schedules/{scheduleId}": {
      "schema": {
        "$ref": "#/entities/ScheduleItem"
      },
      "description": "Private schedule items owned by the authenticated user."
    }
  }
}
